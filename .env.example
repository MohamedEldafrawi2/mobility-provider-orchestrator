# Copy to .env for local development. Values here are development defaults only.

MPO_ENVIRONMENT=dev
MPO_DATABASE_URL=postgresql+asyncpg://mpo:mpo@localhost:5432/mpo
MPO_REDIS_URL=redis://localhost:6379/0

# Listeners. The admin listener is never published outside the compose network.
MPO_HOST=0.0.0.0
MPO_PUBLIC_PORT=8000
MPO_ADMIN_PORT=8001

# Client API keys are stored as SHA-256 hashes: "client_id=hexhash,client_id=hexhash".
# The development key below is the literal string "dev-client-key" (send it as X-API-Key).
MPO_API_KEYS=demo-client=4fc9d2f6da4b6b39fa13514aa754487bad47cd32abdd09815e76039f6fc113a7

# Operator key for the admin listener (send as X-Admin-Key). Development value: "dev-admin-key".
MPO_ADMIN_KEY_HASH=df76ff796f70d2c9cb055ea6280553caa27eda26b70e01082c160de75a05a4a9

# Base URI for RFC 9457 problem types. Set to the public repository URL once published.
MPO_PROBLEM_TYPE_BASE=urn:mpo:problem:

MPO_LOG_JSON=true
# Tracing (optional): set by docker-compose.observability.yml. Unset: no tracing is installed.
# MPO_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# MPO_OTEL_SERVICE_NAME=mpo-api

# Provider simulators
MPO_BUS_LEGACY_URL=http://localhost:9002
MPO_RAIL_OSDM_URL=http://localhost:9001
MPO_MOBILITY_ASYNC_URL=http://localhost:9003
# Standard Webhooks secret(s) Provider C signs with; comma separated during rotation.
MPO_MOBILITY_ASYNC_WEBHOOK_SECRETS=whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw
MPO_SIM_ADMIN_TOKEN=dev-sim-token

# Admission (docs/resilience-strategy.md). The allowance is what each fictional provider documents per second;
# purposes take shares of it (search 45% cap, create 25% cap, confirm/cancel/lookup 10% floors).
MPO_PROVIDER_ALLOWANCE_PER_SECOND=50
MPO_BULKHEAD_SEARCH=32
MPO_BULKHEAD_CREATE=16
MPO_BULKHEAD_CONFIRM=16
MPO_BULKHEAD_CANCEL=8
MPO_BULKHEAD_LOOKUP=8
MPO_BREAKER_FAILURE_RATE_THRESHOLD=0.5
MPO_BREAKER_OPEN_SECONDS=10
MPO_RETRY_MAX_ATTEMPTS=4
MPO_CREATE_MAX_ATTEMPTS=8

# Worker: the confirmation loop's reserved PostgreSQL pool slice and concurrency.
MPO_CONFIRM_POOL_SIZE=8
MPO_WORKER_CONCURRENCY=4
MPO_CONFIRM_LOOP_CONCURRENCY=8
